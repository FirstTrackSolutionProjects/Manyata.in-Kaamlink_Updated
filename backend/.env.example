# Server Port
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Create a Google OAuth Web application client and configure its authorized origins.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173

# Zoho Mail SMTP (use an app-specific password, never your mailbox login password)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=support@themanyata.in
SMTP_PASS=YOUR_ZOHO_APP_SPECIFIC_PASSWORD
SMTP_FROM=support@themanyata.in
CONTACT_SERVICE_EMAIL=support@themanyata.in

# Razorpay (start with Test Mode keys; secrets stay backend-only)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=manyata

# JWT Configuration
# Generate your own secure strings using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

{
  "name": "manyata-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "sequelize-cli --options-path .sequelizerc.cjs db:migrate",
    "db:migrate:undo": "sequelize-cli --options-path .sequelizerc.cjs db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli --options-path .sequelizerc.cjs db:migrate:undo:all",
    "db:seed": "sequelize-cli --options-path .sequelizerc.cjs db:seed:all",
    "admin:create": "node src/scripts/create-admin.js",
    "db:seed:undo": "sequelize-cli --options-path .sequelizerc.cjs db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.6.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.3",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
